# Copy to .env in the repository folder on the server (next to compose.yaml) and fill in.
# Keep .env private: it holds the database password and the prelogin secret.

# The domain pass1 is served on. Its DNS A/AAAA record must point at this server.
DOMAIN=pass1.example.com
# What users type in the address bar. Requests that change data must come from here.
PUBLIC_URL=https://pass1.example.com

# Generate both with:  openssl rand -base64 32
POSTGRES_PASSWORD=
PRELOGIN_SECRET=

# Billing with Paddle (docs/deploy.md, "Billing with Paddle"). Leave all of these empty to run
# pass1 without upgrades; set all of them to turn billing on.
# sandbox while testing with Paddle's test cards, production when taking real payments.
PADDLE_ENVIRONMENT=sandbox
# Paddle → Developer tools → Authentication. The API key is a secret; the client token isn't.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# Paddle → Developer tools → Notifications → your destination's secret key.
PADDLE_WEBHOOK_SECRET=
# Price IDs (pri_…) from Paddle → Catalog → Products.
PADDLE_PRICE_PLUS_YEARLY=
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_UNLIMITED_YEARLY=
PADDLE_PRICE_UNLIMITED_MONTHLY=
# The checkout page's own domain, e.g. pay.pass1.example.com. Its DNS must point here too.
CHECKOUT_DOMAIN=

# Change only to try the stack on your own computer (see docs/deploy.md).
HTTP_PORT=80
HTTPS_PORT=443
