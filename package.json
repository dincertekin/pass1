{
  "name": "pass1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @pass1/web",
    "dev:api": "npm run dev -w @pass1/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run build && npm run test:e2e -w @pass1/e2e",
    "mail:dev": "docker run --rm -d --name pass1-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit:v1.34.0"
  }
}
