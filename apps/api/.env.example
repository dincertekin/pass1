# Copy to .env for local development. Every value has a safe development default,
# so this file is optional until production.

# PORT=3000
# HOST=127.0.0.1
# DATABASE_URL=pglite:./data/pglite
# Production: DATABASE_URL=postgres://pass1:password@localhost:5432/pass1
# WEB_ORIGIN=http://localhost:5173

# Required in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PRELOGIN_SECRET=

# Sign-up emails. Without SMTP_URL, development prints them in the server log instead, link
# included. To see them as real emails, run `npm run mail:dev` (Mailpit) and use:
# SMTP_URL=smtp://localhost:1025
# EMAIL_FROM=pass1 <hello@pass1.example.com>

# Sign-up puzzle difficulty in bits (see src/config.ts). At least 16 in production.
# PROOF_OF_WORK_BITS=19
