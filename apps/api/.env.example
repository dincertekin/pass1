# Copy to .env for local development. Every value has a safe development default,
# so this file is optional until production.

# PORT=3000
# HOST=127.0.0.1
# DATABASE_URL=pglite:./data/pglite
# Production: DATABASE_URL=postgres://pass1:password@localhost:5432/pass1
# WEB_ORIGIN=http://localhost:5173

# Required in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PRELOGIN_SECRET=
